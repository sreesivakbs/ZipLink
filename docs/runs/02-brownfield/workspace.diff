 public interface IShortUrlRepository
 {
+    /// <summary>
+    /// Adds (or overwrites) a record for the given short code.
+    /// </summary>
     Task AddAsync(ShortUrl shortUrl);
+
+    /// <summary>
+    /// Atomically adds the record, returning <c>false</c> when the short code
+    /// is already taken. Used so custom code conflicts are detected without a
+    /// check-then-act race.
+    /// </summary>
+    Task<bool> TryAddAsync(ShortUrl shortUrl);
+
+    /// <summary>
+    /// Returns <c>true</c> when a record exists for the short code, whether or
+    /// not it has expired.
+    /// </summary>
+    Task<bool> ExistsAsync(string shortCode);
+
     Task<ShortUrl?> GetByShortCodeAsync(string shortCode);
+
     Task IncrementClickCountAsync(string shortCode);
 }
