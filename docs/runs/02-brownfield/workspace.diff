+    /// when an expiry is supplied by the caller or a default lifetime is
+    /// configured via <c>ZipLink:DefaultLinkLifetime</c>.
+    /// </summary>
+    public DateTimeOffset? ExpiresAtUtc { get; set; }
+
+    /// <summary>
+    /// <c>true</c> when the short code was supplied by the caller rather than
