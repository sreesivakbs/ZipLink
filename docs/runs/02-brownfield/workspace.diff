+
+    /// <summary>
+    /// Returns <c>true</c> when the link has an expiry that is at or before
+    /// <paramref name="now"/>. Expired records are retained in storage (so
+    /// statistics remain intact) but are refused on resolution.
+    /// </summary>
+    public bool IsExpired(DateTimeOffset now)
+    {
+        return ExpiresAtUtc is { } expiresAtUtc && now >= expiresAtUtc;
+    }
 }
