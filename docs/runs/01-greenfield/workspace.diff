+        _data[shortUrl.ShortCode] = shortUrl;
+        return Task.CompletedTask;
+    }
+
+    public Task<ShortUrl?> GetByShortCodeAsync(string shortCode)
+    {
+        _data.TryGetValue(shortCode, out var result);
+        return Task.FromResult(result);
