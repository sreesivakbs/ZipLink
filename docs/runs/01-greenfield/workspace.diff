+using System.Net;
+using System.Net.Http.Json;
+using System.Text.Json;
+using Microsoft.AspNetCore.Hosting;
+using Microsoft.AspNetCore.Mvc.Testing;
+using Xunit;
+
+namespace ZipLink.Tests;
+
+public class UrlShortenerEndToEndTests
+    : IClassFixture<WebApplicationFactory<Program>>
+{
+    private readonly WebApplicationFactory<Program> _factory;
+
+    public UrlShortenerEndToEndTests(WebApplicationFactory<Program> factory)
+    {
+        _factory = factory.WithWebHostBuilder(
+            builder => builder.UseEnvironment("Testing"));
+    }
+
+    private HttpClient CreateClient()
+    {
+        return _factory.CreateClient(new WebApplicationFactoryClientOptions
+        {
+            AllowAutoRedirect = false
+        });
+    }
+
+    [Fact]
+    public async Task Shorten_ThenFollowCode_RedirectsToOriginalUrl()
+    {
+        var client = CreateClient();
+
+        const string originalUrl = "https://docs.example.com/guide?page=2";
+
+        var createResponse = await client.PostAsJsonAsync(
+            "/api/shorten",
+            new { url = originalUrl });
+
+        Assert.Equal(HttpStatusCode.Created, createResponse.StatusCode);
+
+        var payload = await createResponse.Content
+            .ReadFromJsonAsync<JsonElement>();
+
+        var code = payload.GetProperty("code").GetString();
+        var shortUrl = payload.GetProperty("shortUrl").GetString();
+
+        Assert.False(string.IsNullOrWhiteSpace(code));
+        Assert.NotNull(shortUrl);
+        Assert.EndsWith($"/{code}", shortUrl);
+
+        var redirectResponse = await client.GetAsync($"/{code}");
+
+        Assert.Equal(HttpStatusCode.Found, redirectResponse.StatusCode);
+        Assert.Equal(
+            originalUrl,
+            redirectResponse.Headers.Location?.ToString());
+    }
+
+    [Fact]
+    public async Task Get_WithUnknownCode_ReturnsNotFound()
+    {
+        var client = CreateClient();
+
+        var response = await client.GetAsync("/doesnot");
+
+        Assert.Equal(HttpStatusCode.NotFound, response.StatusCode);
+    }
+
+    [Fact]
+    public async Task Shorten_WithMalformedUrl_ReturnsBadRequest()
+    {
+        var client = CreateClient();
+
+        var response = await client.PostAsJsonAsync(
+            "/api/shorten",
+            new { url = "not-a-url" });
+
+        Assert.Equal(HttpStatusCode.BadRequest, response.StatusCode);
+    }
+
+    [Fact]
+    public async Task Shorten_WithEmptyUrl_ReturnsBadRequest()
+    {
+        var client = CreateClient();
+
+        var response = await client.PostAsJsonAsync(
+            "/api/shorten",
+            new { url = "" });
+
+        Assert.Equal(HttpStatusCode.BadRequest, response.StatusCode);
+    }
+
+    [Fact]
+    public async Task Shorten_ThenReadAnalytics_CountsRedirect()
+    {
+        var client = CreateClient();
+
+        const string originalUrl = "https://analytics.example.com/landing";
+
+        var createResponse = await client.PostAsJsonAsync(
+            "/api/shorten",
+            new { url = originalUrl });
+
+        Assert.Equal(HttpStatusCode.Created, createResponse.StatusCode);
+
+        var payload = await createResponse.Content
+            .ReadFromJsonAsync<JsonElement>();
+
+        var code = payload.GetProperty("code").GetString();
+
+        var redirectResponse = await client.GetAsync($"/{code}");
+
+        Assert.Equal(HttpStatusCode.Found, redirectResponse.StatusCode);
+
+        var analyticsResponse = await client.GetAsync(
+            $"/api/urls/{code}/analytics");
+
+        Assert.Equal(HttpStatusCode.OK, analyticsResponse.StatusCode);
+
+        var analytics = await analyticsResponse.Content
+            .ReadFromJsonAsync<JsonElement>();
+
+        Assert.Equal(
+            originalUrl,
+            analytics.GetProperty("originalUrl").GetString());
+        Assert.Equal(1, analytics.GetProperty("clickCount").GetInt32());
+    }
+}
